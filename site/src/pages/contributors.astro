---
import { ArrowRight } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import { loadCatalog } from "../lib/catalog";

const contributors = [...loadCatalog().reduce((all, sample) => {
  for (const author of sample.authors) {
    const key = author.gitHubAccount.toLocaleLowerCase("en-US");
    const current = all.get(key);
    all.set(key, { ...author, samples: (current?.samples ?? 0) + 1 });
  }
  return all;
}, new Map<string, { gitHubAccount: string; name: string; pictureUrl?: string; samples: number }>()).values()]
  .sort((left, right) => right.samples - left.samples || left.name.localeCompare(right.name));
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const avatarUrl = (author: { gitHubAccount: string; pictureUrl?: string }) => {
  if (author.pictureUrl) {
    const pictureUrl = new URL(author.pictureUrl);
    if (pictureUrl.hostname !== "github.com" || pictureUrl.pathname.endsWith(".png")) {
      return author.pictureUrl;
    }
  }
  return `https://github.com/${encodeURIComponent(author.gitHubAccount)}.png?size=144`;
};
---

<Layout title="Contributors" description="Meet the community members sharing prompts, agent instructions, and skills for Copilot.">
  <header class="page-heading container">
    <p class="eyebrow">Community</p>
    <h1>Contributors</h1>
    <p>Meet the people turning real tasks and hard-won lessons into reusable Copilot patterns for everyone.</p>
  </header>

  <section class="content-section content-section--tint">
    <div class="container recognition-band">
      <img
        src={`${basePath}generated/brand/contributor-badge.png`}
        alt="Prompt Pro Microsoft 365 and Power Platform Community contributor badge"
        width="220"
        height="220"
      />
      <div>
        <p class="eyebrow">Community recognition</p>
        <h2>Earn the Prompt Pro Credly badge</h2>
        <p>Contributors to this repository are recognized with the Prompt Pro digital badge on Credly. Share a prompt, agent instruction, or skill to help the community learn, experiment, and deliver better Copilot experiences.</p>
        <a class="text-link" href="https://aka.ms/community/recognition">Learn how community Credly badges work <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="content-section container">
    <div class="contributor-grid">
      {contributors.map((author) => (
        <article class="contributor-card">
          <img src={avatarUrl(author)} alt="" width="72" height="72" loading="lazy" />
          <div><h2>{author.name}</h2><a href={`https://github.com/${author.gitHubAccount}`}>@{author.gitHubAccount}</a><p>{author.samples} {author.samples === 1 ? "sample" : "samples"}</p></div>
        </article>
      ))}
    </div>
  </section>
</Layout>
